CONFIG_IDF_TARGET="esp32s3"

# Flash / PSRAM (ESP32-S3R2: 16 MB flash, 2 MB quad PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# BLE: NimBLE peripheral only
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
CONFIG_LV_USE_TILEVIEW=y
CONFIG_LV_USE_ARC=y
CONFIG_LV_USE_LINE=y

# app_main runs the UI/BLE dispatch loop; default 3584 is too tight
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Rendering speed: LVGL's software renderer is unusable at -Og
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 60 Hz refresh; LVGL 9 also uses this period for touch reads
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_USE_CLIB_STRING=y
