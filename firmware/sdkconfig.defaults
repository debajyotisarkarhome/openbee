CONFIG_IDF_TARGET="esp32s3"

# Flash / PSRAM (ESP32-S3R2: 16 MB flash, 2 MB quad PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# 80 MHz: the frame buffers and swipe snapshots live in PSRAM (board.c, ui.c)
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# BLE: NimBLE peripheral, plus a GATT client toward the iPhone's Apple Media Service.
# ESP-IDF 5.5 gates the GATT client (BT_NIMBLE_GATT_CLIENT, and the discovery/write procedures in
# esp_nimble_cfg.h) on ROLE_CENTRAL, so it is on; the device still never scans or initiates connections.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
# Bonds survive reboots so a paired iPhone isn't asked again
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
CONFIG_LV_USE_TILEVIEW=y
CONFIG_LV_USE_ARC=y
CONFIG_LV_USE_LINE=y

# app_main runs the UI/BLE dispatch loop; default 3584 is too tight
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Rendering speed: LVGL's software renderer is unusable at -Og
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 60 Hz refresh; LVGL 9 also uses this period for touch reads
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_USE_CLIB_STRING=y
# The Media page bakes its static artwork into one image at boot (bake_media_art in ui.c)
CONFIG_LV_USE_SNAPSHOT=y
# Default 4 is fewer than the distinct circle radii on one page, so circle masks were recomputed every draw
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16
